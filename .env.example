# DSA OS environment. Copy to .env.local and fill in.
# These must point at DSA OS's own Supabase project — never a Peephole project.

# Local development values are printed by `pnpm db:start` (or `pnpm exec supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Used exclusively to create auth accounts for invitations.
# Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Base URL used in invitation and sign-in emails.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
