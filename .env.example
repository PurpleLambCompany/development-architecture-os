# DSA OS environment. Copy to .env.local and fill in.
# These must point at DSA OS's own Supabase project — never a Peephole project.

# Local development values are printed by `pnpm db:start` (or `pnpm exec supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Used exclusively to create auth accounts for invitations.
# Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Base URL used in invitation and sign-in emails.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Production only. Nothing below is needed for local development.
#
# The production domain and email sender are configuration, never code.
# NEXT_PUBLIC_SITE_URL above becomes the production URL on Vercel (for
# example https://<your-domain>); the same value is the Supabase Auth Site URL
# and must be in its redirect allow-list as <site-url>/auth/confirm.
#
# Supabase Auth sends invitation and sign-in emails through this SMTP
# account. Set these where you run `supabase config push` against the hosted
# project, or enter the same values in the Supabase dashboard
# (Authentication → Emails → SMTP settings). Not read by the Next.js app.
# -----------------------------------------------------------------------------
SUPABASE_AUTH_SMTP_HOST=
SUPABASE_AUTH_SMTP_USER=
SUPABASE_AUTH_SMTP_PASS=
SUPABASE_AUTH_SMTP_SENDER_EMAIL=
SUPABASE_AUTH_SMTP_SENDER_NAME=

# Business time zone for due dates, "past due" and "today" (IANA name; never
# CST/CDT). Defaults to America/Chicago when unset.
BUSINESS_TIME_ZONE=America/Chicago

# -----------------------------------------------------------------------------
# Architecture Intelligence (Phase 7B.1). Server-only; never prefix with
# NEXT_PUBLIC_. Leave unset to keep it off. See ADR-0060 and ADR-0062.
# -----------------------------------------------------------------------------
# off (default) | synthetic_only | enabled. Read before every send: the kill switch.
ARCHITECTURE_INTELLIGENCE_MODE=off
# Provider adapter ("openai"; or "fake" for Step A acceptance only), its credential and processing region.
ARCHITECTURE_INTELLIGENCE_PROVIDER=
ARCHITECTURE_INTELLIGENCE_API_KEY=
ARCHITECTURE_INTELLIGENCE_REGION=
ARCHITECTURE_INTELLIGENCE_BASE_URL=
# Requested model and reasoning effort. A resolved model must be listed as
# evaluated in prompts/manifest.ts or its output is refused.
ARCHITECTURE_INTELLIGENCE_MODEL=
ARCHITECTURE_INTELLIGENCE_REASONING_EFFORT=
# JSON price table: {"<model>":{"inputPerMTok":0,"outputPerMTok":0}}. Unpriced models are refused.
ARCHITECTURE_INTELLIGENCE_PRICES=
# Per-request cost ceiling in USD, and provider timeout.
ARCHITECTURE_INTELLIGENCE_MAX_REQUEST_USD=
ARCHITECTURE_INTELLIGENCE_TIMEOUT_MS=
# Step A acceptance only (ADR-0073): the deterministic fake provider runs when
# PROVIDER=fake, MODE=synthetic_only and NODE_ENV is not production, never
# otherwise. No credential; nothing leaves the machine. Scenario: interpretation
# (default), nothing_to_add, invalid_output, refusal or provider_error. The
# resolved model defaults to dsa-fake-model-1; dsa-fake-model-2 shows reuse
# ending on a model change, any other name shows a model not evaluated.
ARCHITECTURE_INTELLIGENCE_FAKE_SCENARIO=
ARCHITECTURE_INTELLIGENCE_FAKE_RESOLVED_MODEL=
